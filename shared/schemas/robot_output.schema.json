{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-welding-ai.local/shared/schemas/robot_output.schema.json",
  "title": "VisionWeldingRobotOutput",
  "description": "승인된 작업 결과를 로봇 제어·용접 프로그램에 전달하기 위한 JSON",
  "type": "object",
  "required": [
    "job_id", "workspace_id", "project_id", "created_at", "assembly_path", "marking", "welding_condition", "cell",
    "leg_lengths", "confidence", "evidence", "needs_review", "approved", "approved_by"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "project_id": { "type": "string", "description": "프로젝트(블록) id", "examples": ["block_a1"] },
    "created_at": { "type": "string", "format": "date-time" },
    "assembly_path": { "type": "string", "examples": ["A1/L1/M2/S1/P-1"] },
    "marking": {
      "type": "object",
      "required": ["raw_text", "symbols", "interpretation"],
      "properties": {
        "raw_text": { "type": "string" },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "interpretation": { "type": "string" }
      }
    },
    "welding_condition": {
      "type": "object",
      "required": ["joint_type", "process", "position", "current_a", "voltage_v", "speed_cm_min"],
      "properties": {
        "joint_type": { "type": "string" },
        "process": { "type": "string" },
        "position": { "type": "string" },
        "current_a": { "type": "string" },
        "voltage_v": { "type": "string" },
        "speed_cm_min": { "type": "string" }
      }
    },
    "cell": {
      "description": "셀 좌·우 끝의 형태. 한쪽에 여러 개가 겹칠 수 있음 (예: 앞 Collar + Scallop). 판별하지 못했으면 null",
      "type": ["object", "null"],
      "required": ["left", "right"],
      "properties": {
        "left": { "type": "array", "items": { "$ref": "#/$defs/CellFeature" } },
        "right": { "type": "array", "items": { "$ref": "#/$defs/CellFeature" } }
      }
    },
    "leg_lengths": {
      "description": "수기 각장 표기 (읽는 순서). 예: F5.5 → 3F 용접장 각장 5.5mm",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "size_mm", "raw_text", "meaning"],
        "properties": {
          "code": { "type": "string", "examples": ["F", "V", "S"] },
          "size_mm": { "type": "number", "exclusiveMinimum": 0 },
          "raw_text": { "type": "string", "examples": ["F5.5"] },
          "meaning": { "type": ["string", "null"], "examples": ["3F 용접장 각장"] }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["visual", "db_consistency", "vlm_reasoning", "overall"],
      "properties": {
        "visual": { "type": "number", "minimum": 0, "maximum": 100 },
        "db_consistency": { "type": "number", "minimum": 0, "maximum": 100 },
        "vlm_reasoning": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "needs_review": { "type": "array", "items": { "type": "string" } },
    "approved": { "type": "boolean" },
    "approved_by": { "type": "string" }
  },
  "$defs": {
    "CellFeature": { "type": "string", "enum": ["slit", "slot", "collar_front", "collar_back", "scallop"] }
  }
}
