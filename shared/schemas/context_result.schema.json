{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-welding-ai.local/shared/schemas/context_result.schema.json",
  "title": "ContextResult",
  "description": "[2단계] DB 기반 맥락 해석 출력. 입력: VisionResult + 워크스페이스 문자/기호 사전 + 프로젝트 조립 트리 + 공통 용접 기준 (+ 작업자 맥락). 생산: 2단계 / 소비: 3단계, 백엔드(Job 필드 채우기). 1단계 결과 대신 VLM 읽기를 해석에 쓴 표기는 vlm.reading의 used가 true",
  "type": "object",
  "required": [
    "dictionary_matches",
    "part",
    "welding_condition",
    "leg_lengths",
    "cell",
    "conflicts",
    "vlm"
  ],
  "additionalProperties": false,
  "properties": {
    "user_context": {
      "type": [
        "string",
        "null"
      ],
      "description": "재해석 때 작업자가 추가한 맥락 (없으면 null)"
    },
    "related_job_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "description": "맥락으로 참고한 같은 워크스페이스의 과거 작업 (Job.related_job_ids 중 실제로 쓴 것). 없으면 빈 배열 또는 생략"
    },
    "dictionary_matches": {
      "type": "array",
      "description": "문자/기호 사전 대조 결과. 1단계 인식 결과 하나 이상을 사전 항목 하나에 대응",
      "items": {
        "$ref": "#/$defs/DictionaryMatch"
      }
    },
    "part": {
      "$ref": "#/$defs/Part",
      "description": "부재·조립 경로. assembly_path가 null이면 3단계는 통과(passed)시킬 수 없음 (로봇 JSON에 assembly_path가 필수)"
    },
    "welding_condition": {
      "description": "용접 기준 DB로 판별한 조건. 판별 못 하면 null. null이면 3단계는 통과(passed)시킬 수 없음 (로봇 JSON에 welding_condition이 필수)",
      "anyOf": [
        {
          "$ref": "#/$defs/WeldingCondition"
        },
        {
          "type": "null"
        }
      ]
    },
    "leg_lengths": {
      "type": "array",
      "description": "수기 각장 표기 (읽는 순서, PAC 과제: F·V·S + mm) → Job.leg_lengths. 작업자가 leg_lengths를 고쳤으면 그 값",
      "items": {
        "$ref": "#/$defs/LegLength"
      }
    },
    "cell": {
      "description": "셀 좌·우 끝 형태 (PAC 과제) → Job.cell. 셀 형태 기호(사전 code slit·slot·collar_front·collar_back·scallop)를 사진 가운데 기준 왼쪽·오른쪽으로 나눔. 셀 형태 기호가 없으면 null",
      "anyOf": [
        {
          "$ref": "#/$defs/Cell"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflicts": {
      "type": "array",
      "description": "DB 불일치 항목 → 3단계 DB 정합성, GUI 작업자 확인 화면",
      "items": {
        "$ref": "#/$defs/Conflict"
      }
    },
    "vlm": {
      "description": "VLM 맥락 해석. VLM을 끈 경우 null",
      "anyOf": [
        {
          "$ref": "#/$defs/VlmResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "vlm_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "VLM을 켰는데 추론이 모두 실패한 이유 (API 키 없음 · 네트워크 · 응답 형식 오류 등). 이때 vlm은 null. 키 값 같은 비밀은 넣지 않음. 생략하면 실패 없음"
    }
  },
  "$defs": {
    "DictionaryMatch": {
      "type": "object",
      "required": [
        "ref_ids",
        "raw",
        "code",
        "meaning",
        "match",
        "score"
      ],
      "additionalProperties": false,
      "properties": {
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          },
          "minItems": 1
        },
        "raw": {
          "type": "string",
          "description": "대조에 쓴 읽기 (1단계 text/label 또는 후보 중 하나)"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "매칭된 사전 code (SymbolEntry.code). 없으면 null"
        },
        "meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "alias",
            "candidate",
            "fuzzy",
            "vlm",
            "none"
          ],
          "description": "exact 그대로 일치 / alias 별칭 일치 / candidate 1단계 후보 중 하나가 일치 / fuzzy 유사 일치 / vlm 사전에 없지만 VLM이 해석 / none 해석 못 함"
        },
        "score": {
          "$ref": "common.schema.json#/$defs/Probability"
        }
      }
    },
    "Part": {
      "description": "조립 경로 대조 결과 (Job.project_id 프로젝트의 조립 트리)",
      "type": "object",
      "required": [
        "node_id",
        "assembly_path",
        "level",
        "found_in_tree",
        "ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "P-1"
          ]
        },
        "assembly_path": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/AssemblyPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "Job.assembly_path로 들어감"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/AssemblyLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "found_in_tree": {
          "type": "boolean",
          "description": "조립 트리에 실제로 있는 부재인지 → 3단계 DB 정합성"
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          }
        }
      }
    },
    "WeldingCondition": {
      "type": "object",
      "required": [
        "joint_type",
        "process",
        "position",
        "current_a",
        "voltage_v",
        "speed_cm_min",
        "standard_matched",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "joint_type": {
          "type": "string"
        },
        "thickness_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "process": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "current_a": {
          "$ref": "common.schema.json#/$defs/RangeValue"
        },
        "voltage_v": {
          "$ref": "common.schema.json#/$defs/RangeValue"
        },
        "speed_cm_min": {
          "$ref": "common.schema.json#/$defs/RangeValue"
        },
        "standard_matched": {
          "type": "boolean",
          "description": "공통 표준 용접 기준(GET /welding-standards)의 한 행과 충돌 없이 일치하는지"
        },
        "source": {
          "type": "string",
          "enum": [
            "standard_db",
            "vlm",
            "manual"
          ],
          "description": "standard_db 기준표 조회 / vlm VLM 추론 / manual 작업자 직접 입력"
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          },
          "description": "판별 근거가 된 표기 (예: 이음 형태 FW, 판 두께 t=10). GUI가 사진 위에 강조할 때 씀. 작업자가 직접 입력(manual)하면 생략"
        },
        "leg_length_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "판별 근거가 된 각장 (판 두께 표기 없이 각장 표기로 기준 행을 고른 경우)"
        }
      },
      "description": "Job.welding_condition의 6개 필드 + 판별 근거(thickness_mm, leg_length_mm, standard_matched, source)"
    },
    "LegLength": {
      "type": "object",
      "required": [
        "code",
        "size_mm",
        "raw_text",
        "meaning",
        "ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "사전 code (데모 사전: F 3F 용접장, V 2F 용접장, S 스티프너)"
        },
        "size_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "raw_text": {
          "type": "string",
          "description": "해석에 쓴 표기 (예: F5.5). 소수점이 빠진 읽기를 고쳤으면 고친 값"
        },
        "meaning": {
          "type": [
            "string",
            "null"
          ],
          "description": "사전 뜻 (예: 3F 용접장 각장)"
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          },
          "description": "근거 표기. 작업자가 직접 입력했으면 빈 배열"
        }
      }
    },
    "Cell": {
      "type": "object",
      "required": [
        "left",
        "right",
        "ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CellFeature"
          }
        },
        "right": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CellFeature"
          }
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          },
          "description": "근거 기호. 작업자가 직접 입력했으면 빈 배열"
        }
      }
    },
    "Conflict": {
      "type": "object",
      "required": [
        "type",
        "severity",
        "message",
        "ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dictionary_unmatched",
            "part_not_in_tree",
            "standard_conflict",
            "ocr_vlm_mismatch",
            "ambiguous_reading"
          ],
          "description": "3단계 needs_review.reason에 같은 이름으로 이어짐"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "작업자에게 보여 줄 설명"
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RefId"
          }
        }
      }
    },
    "VlmResult": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "interpretation",
        "reading",
        "token_prob",
        "consistency",
        "runs"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/VlmProvider"
        },
        "model": {
          "type": "string",
          "examples": [
            "claude-opus-5-5"
          ]
        },
        "interpretation": {
          "type": "string",
          "description": "자연어 해석 한두 문장 → Job.marking.interpretation"
        },
        "image_attached": {
          "type": "boolean",
          "description": "VLM이 사진을 보고 해석했는지 (사진 없이 1단계 결과만 보면 false). 생략하면 모름"
        },
        "reading": {
          "description": "VLM이 이미지에서 직접 읽은 글자·기호 → 3단계 OCR↔VLM 교차 검증. 1단계가 놓친 표기는 2단계가 v1, v2, …를 붙여 뒤 단계가 다른 인식 결과처럼 가리킬 수 있게 함",
          "type": "object",
          "required": [
            "texts",
            "symbols"
          ],
          "additionalProperties": false,
          "properties": {
            "texts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "ref_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref_id": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/TextId"
                      },
                      {
                        "$ref": "common.schema.json#/$defs/VlmId"
                      }
                    ],
                    "description": "대응하는 1단계 결과(t*). 1단계가 놓친 표기면 2단계가 붙인 v*"
                  },
                  "bbox": {
                    "$ref": "common.schema.json#/$defs/BBox",
                    "description": "VLM이 알려 준 대략적 위치 (선택). v* 표기를 사진 위에 그리거나 읽는 순서를 정할 때 씀"
                  },
                  "used": {
                    "type": "boolean",
                    "description": "1단계(t*·s*)와 다르게 읽었고 2단계가 이 VLM 읽기를 해석에 썼는지 — 사진을 본 VLM이 읽은 값이 사전·판 두께 규칙에 맞거나 1단계 확률이 낮을 때. Job.marking도 이 값을 씀"
                  }
                }
              }
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "ref_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref_id": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/SymbolId"
                      },
                      {
                        "$ref": "common.schema.json#/$defs/VlmId"
                      }
                    ],
                    "description": "대응하는 1단계 결과(s*). 1단계가 놓친 기호면 2단계가 붙인 v*"
                  },
                  "bbox": {
                    "$ref": "common.schema.json#/$defs/BBox",
                    "description": "VLM이 알려 준 대략적 위치 (선택). v* 표기를 사진 위에 그리거나 읽는 순서를 정할 때 씀"
                  },
                  "used": {
                    "type": "boolean",
                    "description": "1단계(t*·s*)와 다르게 읽었고 2단계가 이 VLM 읽기를 해석에 썼는지 — 사진을 본 VLM이 읽은 값이 사전·판 두께 규칙에 맞거나 1단계 확률이 낮을 때. Job.marking도 이 값을 씀"
                  }
                }
              }
            }
          }
        },
        "token_prob": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "description": "출력 토큰 확률. 제공하지 않는 모델(Claude 등)은 null"
        },
        "consistency": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "description": "같은 입력으로 runs번 추론했을 때 해석이 일치한 비율. runs가 1이면 null"
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
