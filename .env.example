# 복사해서 쓰기: cp .env.example .env  (.env 는 .gitignore 에 있어 커밋되지 않음 — 키는 .env 에만)
# 백엔드(app/main.py)가 시작할 때 저장소 루트의 .env 를 읽음. 이미 설정된 환경 변수가 우선

# VLM providers (사용하는 것만 채우기)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# [2단계] VLM — 비우거나 off 면 VLM 없이 DB 대조만
VLM_PROVIDER=claude   # claude | gpt | gemini | qwen3-vl | internvl | off
VLM_MODEL=            # 비우면 provider 기본 모델 (claude: claude-opus-5-5)
VLM_RUNS=3            # 같은 사진을 몇 번 추론할지 (다중 추론 일관성). 1이면 비용 1/3, 일관성은 계산 안 함
# 로컬 모델(qwen3-vl · internvl)의 OpenAI 호환 서버
# VLM_BASE_URL=http://localhost:8001/v1

# 신뢰도 임계값 (0~100)
CONFIDENCE_THRESHOLD=80

DATABASE_URL=sqlite:///./vision_welding.db
