# 복사해서 쓰기: cp .env.example .env  (.env 는 .gitignore 에 있어 커밋되지 않음 — 키는 .env 에만)
# 백엔드(app/main.py)가 시작할 때 저장소 루트의 .env 를 읽음. 이미 설정된 환경 변수가 우선

# VLM providers (사용하는 것만 채우기)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# [2단계] VLM — 기본은 꺼짐(off): VLM 없이 OCR + DB 대조만. 키를 채운 provider 이름으로 바꿔서 켬
# (키 없이 켜 두면 해석할 때마다 호출이 실패함 — 실패 이유는 작업의 확인 항목과 GET /pipeline/status 에 나옴)
VLM_PROVIDER=off      # claude | gpt | gemini | qwen3-vl | internvl | off
VLM_MODEL=            # 비우면 provider 기본 모델 (claude: claude-opus-5-5)
VLM_RUNS=3            # 같은 사진을 몇 번 추론할지 (동시에 보냄, 다중 추론 일관성). 1이면 비용 1/3이지만 일관성을 못 재서 3단계가 확인 필요로 둠
# 로컬 모델(qwen3-vl · internvl)의 OpenAI 호환 서버
# VLM_BASE_URL=http://localhost:8001/v1

# [1단계] 추가 학습한 OCR 모델 폴더 (저장소 루트 기준 상대 경로 가능). 비우면 PaddleOCR 공식 모델
#   팀에서 받은 det_v3_inference.zip · rec_v4_inference.zip 을 푼 폴더 — weights/ 는 커밋되지 않음 (README '학습한 1단계 모델 쓰기')
#   예: VISION_DET_MODEL_DIR=weights/det_v3/inference  VISION_REC_MODEL_DIR=weights/rec_v4/inference
VISION_DET_MODEL_DIR=
VISION_REC_MODEL_DIR=

# 신뢰도 임계값 (0~100)
CONFIDENCE_THRESHOLD=80

# 저장소 DB — 서버를 다시 켜도 작업·사진·해석 결과가 남음. DB 가 비어 있으면 시드 상태로 시작
#   PostgreSQL(기본): 저장소 루트에서 docker compose up -d db 로 띄움. 시드로 되돌리기: docker compose down -v
#   SQLite 파일(PostgreSQL 없이): sqlite:///./vision_welding.db (backend/ 기준)   비우면 메모리만 (테스트)
DATABASE_URL=postgresql://vision:vision@localhost:5433/vision_welding

# 백엔드를 켤 때 OCR 모델을 미리 불러 둠 (첫 해석이 1분 가까이 걸리지 않게). 0이면 끔
PRELOAD_MODELS=1
